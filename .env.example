# Copy this file to .env and fill it in. .env is never committed.
# "local" saves into content/posts on this computer, "github" saves to the live site.
EDITOR_STORE=local
GITHUB_TOKEN=
GITHUB_REPO=JogaProTeens/jogaproteens_stranky
GITHUB_BRANCH=main
# Login, needed for "github". Create both lines with: python -m editor.auth
EDITOR_PASSWORD_HASH=
SESSION_SECRET=
